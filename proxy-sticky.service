[Unit]
Description=proxy-sticky SOCKS5 sticky IPv6 egress
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/azureuser/proxy-sticky/bin/proxy-sticky --config /home/azureuser/proxy-sticky/config.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
